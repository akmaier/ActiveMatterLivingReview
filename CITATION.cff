    given-names: Andreas
    email: andreas.maier@fau.de
    affiliation: Friedrich-Alexander-Universität Erlangen-Nürnberg
repository-code: "https://github.com/akmaier/ActiveMatterLivingReview"
url: "https://akmaier.github.io/ActiveMatterLivingReview/"
